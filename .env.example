# dev (default), staging, or production (see src/api/startup_config.py).
# staging/production activate the fail-fast Configuration Contract below --
# LLM_PROVIDER/EMBEDDING_PROVIDER may not be "mock", DATABASE_URL may not be
# SQLite or the default dev-only Postgres credentials, and every "Sim"
# variable in this file becomes mandatory at boot. docker-compose.yml
# already defaults this to "production" for that deployment vehicle.
ENVIRONMENT=dev

LLM_PROVIDER=mock

# Only used when LLM_PROVIDER=anthropic. Unset -> defaults to the model hardcoded in
# ProductionLLMProvider (src/llm/providers/production_provider.py).
MODEL_NAME=
ANTHROPIC_API_KEY=

# Production Embedding Provider Approval (Founder Decision, D-177):
# EMBEDDING_PROVIDER=voyage uses Voyage AI (model voyage-4, dimension 1024 --
# see src/services/knowledge_platform/embedding_provider.py). Only used when
# EMBEDDING_PROVIDER=voyage.
EMBEDDING_PROVIDER=mock
VOYAGE_API_KEY=

# Required by every /api/* route (see docs/technical/04-api-design.md#authentication).
# Clients must send it back as the X-API-Key header. Unset -> all protected routes return 503.
API_KEY=

# Comma-separated list of browser origins allowed to call the API cross-origin
# (see docs/technical/04-api-design.md#cors). Unset -> no origin is allowed.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Requests allowed per API key within the window below (see
# docs/technical/04-api-design.md#rate-limiting). Defaults: 60 requests / 60 seconds.
RATE_LIMIT_MAX_REQUESTS=
RATE_LIMIT_WINDOW_SECONDS=

# RC-2: PostgreSQL is the official development/production database.
# Example: postgresql://aipmo:aipmo@localhost:5432/aipmo
# After setting this, run: alembic upgrade head (creates schema + seeds
# Enterprise Domain data -- see docs/product/release-candidate/RC-2/).
# Unset -> falls back to sqlite:///./ai_pmo_copilot.db, kept only for quick
# local smoke-testing and for the test suite's isolated per-test databases;
# it is not a supported deployment target.
DATABASE_URL=

# Connection pool (Postgres only -- SQLite ignores these). See
# src/database/engine.py. Defaults shown are applied when unset.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800
# DB_POOL_PRE_PING=true

# Only consumed by docker-compose.yml (not by src/, which only ever reads
# DATABASE_URL above) -- interpolated into both the `database` service's own
# credentials and the `api` service's DATABASE_URL, so overriding these here
# keeps the two consistent automatically. Unset -> all three default to
# "aipmo" (local dev only, unchanged). W7-1 Staging Deployment Readiness
# (Founder Decision, D-179): staging/production MUST override
# POSTGRES_PASSWORD (real secret, never committed) -- the Configuration
# Contract (src/api/startup_config.py) fails the boot if DATABASE_URL still
# resolves to the default "aipmo:aipmo" credentials outside dev.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# Release identity (W7-5, Technical Design S11), exposed read-only at
# GET /health as "release". Never set at runtime -- Dockerfile/web/Dockerfile
# bake it at build time from the GIT_SHA build arg (ARG GIT_SHA=unknown; ENV
# RELEASE_SHA=${GIT_SHA}). GIT_SHA below is only consumed by
# `docker compose build` (docker-compose.yml's `build.args.GIT_SHA`) --
# unset -> images build with RELEASE_SHA=unknown.
# GIT_SHA=$(git rev-parse HEAD)
